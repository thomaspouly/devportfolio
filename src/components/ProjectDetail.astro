---
import { siteConfig, type Project } from "../config";
import { ui } from "../i18n";
import LocalizedText from "./LocalizedText.astro";
import PhoneMockup from "./PhoneMockup.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const accent = siteConfig.accentColor;
const screenshots = project.screenshots?.filter(Boolean) ?? [];
const links = project.links?.filter((link) => link.href) ?? [];
const hasVideo = Boolean(project.video);
const isDirectVideo =
  hasVideo && /\.(mp4|webm|ogg|gif)$/i.test(project.video ?? "");
const caseStudy = project.caseStudy;

const sections = caseStudy
  ? [
      { title: ui.problem, body: caseStudy.problem },
      { title: ui.myRole, body: caseStudy.role },
      { title: ui.choices, body: caseStudy.choices },
      { title: ui.challenges, body: caseStudy.challenges },
      { title: ui.results, body: caseStudy.results },
      { title: ui.improve, body: caseStudy.improve },
    ].filter((section) => section.body.fr || section.body.en)
  : [];
---

<article class="bg-white">
  <header class="px-8 sm:px-12 md:px-16 lg:px-24 pt-28 md:pt-32 pb-10">
    <a
      href="/#projects"
      class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-gray-900 transition-colors mb-8"
    >
      <span aria-hidden="true">←</span>
      <LocalizedText text={ui.allProjects} />
    </a>

    <p class="text-sm font-mono mb-3" style={`color: ${accent}`}>
      <LocalizedText text={ui.caseStudy} />
    </p>
    <h1
      class="text-3xl sm:text-4xl md:text-5xl xl:text-6xl font-bold text-gray-900 text-pretty"
    >
      <LocalizedText text={project.name} />
    </h1>
    <p
      class="mt-6 max-w-3xl text-lg sm:text-xl md:text-2xl leading-relaxed text-gray-600"
    >
      <LocalizedText text={project.hook} />
    </p>

    <div
      class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm sm:text-base text-gray-700"
    >
      {
        project.role && (
          <p>
            <span class="text-gray-400">
              <LocalizedText text={ui.role} />
            </span>{" "}
            <LocalizedText text={project.role} />
          </p>
        )
      }
      {
        project.duration && (
          <p>
            <span class="text-gray-400">
              <LocalizedText text={ui.duration} />
            </span>{" "}
            <LocalizedText text={project.duration} />
          </p>
        )
      }
    </div>

    {
      project.skills.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-2">
          {project.skills.map((skill) => (
            <span class="px-2.5 sm:px-3 py-1 sm:py-1.5 bg-gray-900 text-white rounded-md sm:rounded-lg text-xs sm:text-sm font-medium">
              {skill}
            </span>
          ))}
        </div>
      )
    }

    {
      links.length > 0 && (
        <div class="mt-8 flex flex-wrap gap-3">
          {links.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-gray-200 text-sm font-medium text-gray-800 hover:bg-gray-50 hover:border-gray-300 transition-colors"
            >
              <LocalizedText text={link.label} />
              <svg
                class="w-3.5 h-3.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M7 17L17 7M17 7H7M17 7V17"></path>
              </svg>
            </a>
          ))}
        </div>
      )
    }
  </header>

  {
    (hasVideo || screenshots.length > 0) && (
      <section class="px-8 sm:px-12 md:px-16 lg:px-24 pb-16">
        <div class="rounded-2xl border border-gray-200 bg-gray-50 p-6 sm:p-8 md:p-12">
          {hasVideo && (
            <div class="mb-10">
              {isDirectVideo ? (
                project.video?.endsWith(".gif") ? (
                  <img
                    src={project.video}
                    alt={project.name.fr}
                    class="w-full max-w-3xl mx-auto rounded-xl border border-gray-200"
                  />
                ) : (
                  <video
                    src={project.video}
                    controls
                    muted
                    playsinline
                    class="w-full max-w-3xl mx-auto rounded-xl border border-gray-200 bg-black"
                  >
                    {project.name.fr}
                  </video>
                )
              ) : (
                <div class="relative w-full max-w-3xl mx-auto aspect-video rounded-xl overflow-hidden border border-gray-200 bg-black">
                  <iframe
                    src={project.video}
                    title={project.name.fr}
                    class="absolute inset-0 h-full w-full"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                  />
                </div>
              )}
              <p class="mt-3 text-center text-sm text-gray-500">
                <LocalizedText text={ui.demoCaption} />
              </p>
            </div>
          )}

          {screenshots.length > 0 && (
            <div class="flex flex-wrap justify-center gap-6 md:gap-8">
              {screenshots.slice(0, 5).map((src, index) => (
                <PhoneMockup
                  src={src}
                  alt={`${project.name.fr} — ${index + 1}`}
                />
              ))}
            </div>
          )}
        </div>
      </section>
    )
  }

  {
    sections.length > 0 && (
      <section class="px-8 sm:px-12 md:px-16 lg:px-24 pb-24">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">
              <LocalizedText text={ui.caseStudy} />
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${accent}`}
            />
          </div>
          <div class="lg:col-span-8 space-y-10">
            {sections.map((section) => (
              <div>
                <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mb-3">
                  <LocalizedText text={section.title} />
                </h3>
                <p class="text-base sm:text-lg leading-relaxed text-gray-600">
                  <LocalizedText text={section.body} />
                </p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }
</article>
