---
import { siteConfig } from "../config";
import { ui } from "../i18n";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import LocalizedText from "./LocalizedText.astro";

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
const home = Astro.url.pathname === "/" ? "" : "/";
---

<header
  id="header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <div
    class="relative max-w-7xl mx-auto px-4 sm:px-8 py-4 flex items-center justify-center"
  >
    <nav class="hidden md:block">
      <ul class="flex items-center gap-8 justify-center">
        <li>
          <a
            href={`${home}#about`}
            class="text-gray-700 hover:text-black transition-colors font-medium"
          >
            <LocalizedText text={ui.about} />
          </a>
        </li>
        {
          hasProjects && (
            <li>
              <a
                href={`${home}#projects`}
                class="text-gray-700 hover:text-black transition-colors font-medium"
              >
                <LocalizedText text={ui.projects} />
              </a>
            </li>
          )
        }
        {
          hasExperience && (
            <li>
              <a
                href={`${home}#experience`}
                class="text-gray-700 hover:text-black transition-colors font-medium"
              >
                <LocalizedText text={ui.experience} />
              </a>
            </li>
          )
        }
        {
          hasEducation && (
            <li>
              <a
                href={`${home}#education`}
                class="text-gray-700 hover:text-black transition-colors font-medium"
              >
                <LocalizedText text={ui.education} />
              </a>
            </li>
          )
        }
      </ul>
    </nav>
    <div class="absolute right-4 sm:right-8 top-1/2 -translate-y-1/2">
      <LanguageSwitcher />
    </div>
  </div>
</header>

<script>
  window.addEventListener("scroll", () => {
    const header = document.getElementById("header");
    if (window.scrollY > 100) {
      header?.classList.add("bg-white/80", "backdrop-blur-sm");
    } else {
      header?.classList.remove("bg-white/80", "backdrop-blur-sm");
    }
  });
</script>

<style>
  html {
    scroll-behavior: smooth;
  }
</style>
