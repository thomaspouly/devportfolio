---
interface Props {
  src: string;
  alt: string;
}

const { src, alt } = Astro.props;
---

<figure class="flex flex-col items-center gap-3">
  <div
    class="relative w-[160px] sm:w-[180px] md:w-[200px] aspect-[9/19] rounded-[2rem] bg-gray-900 p-2 shadow-xl"
  >
    <div
      class="absolute top-3 left-1/2 -translate-x-1/2 z-10 h-4 w-16 rounded-full bg-black/80"
    >
    </div>
    <div
      class="h-full w-full overflow-hidden rounded-[1.5rem] bg-gray-100 border border-gray-800"
    >
      <img src={src} alt={alt} class="h-full w-full object-cover object-top" />
    </div>
  </div>
  <figcaption class="sr-only">{alt}</figcaption>
</figure>
